# The web app (search UI, pilot screens and /api) for Railway (ADR-13).
# It needs no browser: Chromium is only for the Accela ingest adapters, which
# use the root Dockerfile. Keeping it out makes the image small and avoids
# the Playwright browser download that fails on Railway's builder.
FROM node:20-slim

ENV NODE_ENV=production \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

COPY . .
USER node
EXPOSE 3000
# Migrations first, then the server. Railway's pre-deploy command
# (railway.json) was proved not to run on 2026-11-14: code that shipped
# migrations 029-030 went live on a schema-28 database. db/apply.js is
# idempotent and takes the same advisory lock as the sync; if it fails the
# container exits and Railway keeps the previous deploy serving.
CMD ["sh", "-c", "node db/apply.js start && exec node web/server.js"]
